---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Cta from '../components/Cta.astro';
import Portfolio from '../components/Portfolio.astro';
import { portfolio, filters } from '../data.js';
---
<Base title="Portfolio — Display Egypt Advertising" description="Selected outdoor campaigns, events, exhibition booths, activations, and creative work by Display Egypt Advertising.">
  <Hero eyebrow="Portfolio" title="Work that holds a room — and a roadside." text="Outdoor campaigns, concerts and conferences, exhibition booths, mall and beach activations, and digital creative. Crafted for major brands and delivered with unparalleled commitment." image="/assets/work/event-maskoon.webp?v=1" alt="Maskoon indoor event stage with light beams" />
  <section class="de-section">
    <div class="de-container">
      <div class="de-filters" role="group" aria-label="Filter projects">
        {filters.map(([key, label], i) => <button type="button" class={`de-filter${i === 0 ? ' is-active' : ''}`} data-filter={key} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>)}
      </div>
      <Portfolio items={portfolio} page />
    </div>
  </section>
  <Cta />
</Base>
