---
import Base from '../layouts/Base.astro';
---
<Base solid title="Page not found — Display Egypt">
  <section class="nf">
    <div class="de-container nf__inner">
      <video class="nf__video" src="/assets/video/404.mp4" autoplay muted loop playsinline preload="auto" aria-hidden="true"></video>
      <p class="nf__code">404</p>
      <h1>Page not found. Signal also not found. Honestly, nothing found.</h1>
      <p class="nf__text">I looked everywhere. Even behind the couch.</p>
      <div class="nf__actions">
        <a class="de-btn de-btn--primary" href="/">Back to Home</a>
        <a class="de-btn de-btn--dark" href="/our-portfolio/">View Our Work</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { padding: 5.5rem 0 2.5rem; background: #fff; text-align: center; }
  .nf__inner { display: flex; flex-direction: column; align-items: center; }
  .nf__video { width: min(26rem, 92vw); aspect-ratio: 2 / 1; object-fit: cover; mix-blend-mode: multiply; }
  .nf__code { margin: 0.2rem 0 0; font: 800 clamp(3rem, 7vw, 4.5rem)/1 var(--de-display, inherit); color: var(--de-red, #e00); letter-spacing: 0.04em; }
  .nf h1 { margin: 0.2rem 0 0; max-width: 52rem; font-size: clamp(1.3rem, 3vw, 2rem); text-transform: uppercase; }
  .nf__text { max-width: 36rem; margin: 0.8rem 0 0; font-size: clamp(1.1rem, 2.4vw, 1.4rem); color: #333; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; margin-top: 1.4rem; }
</style>
