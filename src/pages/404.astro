---
import Base from '../layouts/Base.astro';
---
<Base solid title="Page not found — Display Egypt">
  <section class="nf">
    <div class="de-container nf__inner">
      <video class="nf__video" src="/assets/video/404.mp4" autoplay muted loop playsinline preload="auto" aria-hidden="true"></video>
      <p class="nf__code">404</p>
      <h1>Looks like this page went off the grid.</h1>
      <p class="nf__text">The page you are looking for does not exist or has moved. Let's get you back on track.</p>
      <div class="nf__actions">
        <a class="de-btn de-btn--primary" href="/">Back to Home</a>
        <a class="de-btn de-btn--dark" href="/our-portfolio/">View Our Work</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { padding: 7rem 0 4rem; background: #fff; text-align: center; }
  .nf__inner { display: flex; flex-direction: column; align-items: center; }
  .nf__video { width: min(24rem, 80vw); aspect-ratio: 1; mix-blend-mode: multiply; margin: -2.5rem 0 -1rem; }
  .nf__code { margin: 0; font: 800 clamp(3rem, 8vw, 5rem)/1 var(--de-display, inherit); color: var(--de-red, #e00); letter-spacing: 0.04em; }
  .nf h1 { margin: 0.5rem 0 0; font-size: clamp(1.4rem, 3.4vw, 2.2rem); text-transform: uppercase; }
  .nf__text { max-width: 34rem; margin: 1rem 0 0; color: #555; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; margin-top: 1.8rem; }
</style>
