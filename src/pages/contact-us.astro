---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { contact, hero } from '../data.js';
const waText = encodeURIComponent('Hello Display Egypt, I would like to talk about a project.');
const wa = `${contact.phoneHref}?text=${waText}`;
---
<Base title="Contact — Display Egypt Advertising" description="Talk to Display Egypt Advertising about outdoor, events, exhibition booths, digital, and creative. WhatsApp +20 10 3694 9949 or email info@displayegypt.com.">
  <Hero short eyebrow="Contact" title="Let’s talk. We’d love to hear from you." text="Have a project in mind? Looking for a reliable partner to bring your vision to life? We’re always ready to listen, brainstorm, and build something extraordinary together." image={hero('203')} alt="Concert stage lights at a Display Egypt event" />
  <section class="de-section">
    <div class="de-container de-contact">
      <div class="de-contact__info de-reveal">
        <h2>Direct channels</h2>
        <p>Reach us on WhatsApp, by email, or find us at the studio. We’ll get back to you as soon as possible.</p>
        <ul class="de-contact__list">
          <li><span>WhatsApp / Phone</span><a href={wa} target="_blank" rel="noopener">{contact.phone}</a></li>
          <li><span>Email</span><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><span>Studio</span><address>{contact.address}</address></li>
          <li>
            <span>Follow us</span>
            <div class="de-social de-social--solid">
              {contact.social.map((s) => <a class="de-social__link" href={s.href} target="_blank" rel="noopener" aria-label={s.name}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={s.icon}/></svg></a>)}
            </div>
          </li>
        </ul>
      </div>
      <div class="de-contact__wa de-reveal">
        <h2>Message us on WhatsApp</h2>
        <p>The fastest way to reach the team. Tell us about your campaign, event, or booth and we’ll reply on WhatsApp.</p>
        <a class="de-btn de-btn--primary de-btn--wa" href={wa} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12.04 2a9.9 9.9 0 0 0-8.5 14.9L2 22l5.25-1.38A9.9 9.9 0 1 0 12.04 2zm0 1.8a8.1 8.1 0 1 1-4.1 15.1l-.3-.17-3.12.82.83-3.04-.2-.31A8.1 8.1 0 0 1 12.04 3.8zM8.6 7.5c-.2 0-.5.07-.77.37-.26.3-1 1-1 2.4s1.03 2.8 1.17 3c.14.2 2 3.2 5 4.4 2.5 1 3 .8 3.5.75.5-.05 1.7-.7 1.95-1.4.24-.7.24-1.3.17-1.4-.07-.13-.27-.2-.57-.35-.3-.15-1.7-.85-2-.95-.27-.1-.47-.15-.67.15-.2.3-.77.95-.94 1.15-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.4-1.47-.9-.8-1.5-1.77-1.67-2.07-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.65-.93-2.25-.24-.57-.5-.5-.67-.5z"/></svg>
          Chat on WhatsApp
        </a>
        <p class="de-contact__alt">Prefer email? Write to <a href={`mailto:${contact.email}`}>{contact.email}</a>.</p>
      </div>
    </div>
  </section>
</Base>
