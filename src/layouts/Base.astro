---
import { contact, services } from '../data.js';
import Lightbox from '../components/Lightbox.astro';
const { solid = false, title, description ='Display Egypt is a professional advertising and outdoor media company specialising in OOH campaigns, event production, printing, and creative services in Cairo and across Egypt.', image = '/assets/images/hero-cairo-ooh.jpg' } = Astro.props;
const path = Astro.url.pathname;
const nav = [['/', 'Home'], ['/about/', 'About'], ['/services/', 'Services'], ['/our-portfolio/', 'Portfolio']];
const tabs = [
  ['/', 'Home', '<path d="M3 11l9-8 9 8v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>'],
  ['/services/', 'Services', '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>'],
  ['/our-portfolio/', 'Work', '<rect x="3" y="3" width="18" height="18" rx="2.5"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-5-5L5 21"/>'],
  ['/about/', 'About', '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14c2.2.6 3.5 2.4 3.5 5"/>'],
  ['/contact-us/', 'Contact', '<path d="M21 12a8 8 0 0 1-11.7 7L3 21l2-5.3A8 8 0 1 1 21 12z"/>'],
];
const isActive = (href) => (href === '/' ? path === '/' : path.startsWith(href));
const year = new Date().getFullYear();
const v = Date.now().toString(36); // cache-bust css/js on every build
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:image" content={new URL(image, Astro.site)}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#000000">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Display">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800;900&family=Space+Grotesk:wght@400;500;700&display=swap">
<link rel="stylesheet" href={`/assets/css/main.css?v=${v}`}>
<link rel="stylesheet" href={`/assets/css/nav.css?v=${v}`}>
<link rel="stylesheet" href={`/assets/css/motion.css?v=${v}`}>
<link rel="stylesheet" href={`/assets/css/hero3d.css?v=${v}`}>
<link rel="stylesheet" href={`/assets/css/brand.css?v=${v}`}>
<link rel="stylesheet" href={`/assets/css/sections.css?v=${v}`}>
<link rel="stylesheet" href={`/assets/css/loader.css?v=${v}`}>
<link rel="stylesheet" href={`/assets/css/app.css?v=${v}`}>
<script is:inline>
/* app mode: installed PWA (standalone) or ?app=1 to preview it in a normal browser (?app=0 turns it off) */
(function(){var d=document.documentElement,on=false;try{
var q=location.search.match(/[?&]app=([01])/);
if(q){if(q[1]==="1")sessionStorage.setItem("de-app","1");else sessionStorage.removeItem("de-app")}
on=matchMedia("(display-mode: standalone)").matches||navigator.standalone===true||sessionStorage.getItem("de-app")==="1";
}catch(e){}if(on)d.classList.add("is-app")})();
</script>
<script is:inline>var d=document.documentElement,k="de-motion",off=/[?&]motion=off/.test(location.search);try{if(off)localStorage.setItem(k,"off");if(/[?&]motion=on/.test(location.search)){localStorage.removeItem(k);off=false}else if(!off)off=localStorage.getItem(k)==="off"}catch(e){}d.classList.add("js");if(off)d.classList.add("reduce-motion")</script>
</head>
<script is:inline>
/* intro loader: only when someone OPENS the site from a link (home page, fresh navigation from outside).
   Reload, back/forward and clicking around inside the site open normally. ?loader=1 forces it for previews. */
(function(){var d=document.documentElement;try{
var force=/[?&]loader=1/.test(location.search);
var nav=performance.getEntriesByType&&performance.getEntriesByType("navigation")[0];
var fresh=!nav||nav.type==="navigate";
var internal=document.referrer&&document.referrer.indexOf(location.origin)===0;
var home=location.pathname==="/"||location.pathname==="/index.html";
if((force||(home&&fresh&&!internal))&&!d.classList.contains("reduce-motion")){d.classList.add("de-loading");setTimeout(function(){d.classList.remove("de-loading")},3400)}
}catch(e){}})();
</script>
<body class="de-site de-redesign">
<div class="de-loader" aria-hidden="true">
  <div class="de-loader__pair">
    <div class="de-loader__mark"><img src="/assets/images/logo-mark.webp" alt="" width="486" height="288"></div>
    <div class="de-loader__name"><div><div class="de-loader__text"><strong>Display Egypt</strong><span>Advertising</span></div></div></div>
  </div>
</div>
<a class="de-skip" href="#content">Skip to content</a>
<header class={`de-header${solid ? ' is-solid' : ''}`} id="masthead">
  <div class="de-header__bar">
    <nav class="de-nav" id="site-navigation" aria-label="Primary">
      <ul class="de-nav__list">
        {nav.map(([href, label]) => <li class={`menu-item de-nav__item${path === href ? ' current-menu-item' : ''}`}><a class="de-nav__link" href={href}>{label}</a></li>)}
      </ul>
    </nav>
    <a class="de-logo" href="/" aria-label="Display Egypt">
      <img class="de-logo__img de-logo__img--light" src="/assets/images/logo-dea-light.webp" alt="Display Egypt Advertising" width="498" height="357" decoding="async">
      <img class="de-logo__img de-logo__img--dark" src="/assets/images/logo-dea-dark.webp" alt="" aria-hidden="true" width="761" height="537" decoding="async">
    </a>
    <div class="de-header__end">
      <a class="de-btn de-btn--header" href="/contact-us/"><span>Contact Us</span><svg class="de-btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <button class="de-nav-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" aria-label="Open menu"><span class="de-nav-toggle__bars" aria-hidden="true"></span></button>
    </div>
  </div>
</header>
<div class="de-nav-overlay" hidden></div>
<div class="de-appbar" aria-hidden="false">
  <a class="de-appbar__logo" href="/" aria-label="Display Egypt"><img src="/assets/images/logo-dea-light.webp" alt="Display Egypt Advertising" width="498" height="357"></a>
  <a class="de-appbar__wa" href={contact.phoneHref} target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg></a>
</div>
<div id="content" class="de-content"><slot /></div>
<footer class="de-footer" id="colophon">
  <div class="de-container de-footer__grid">
    <div class="de-footer__brand">
      <a class="de-logo de-logo--footer" href="/" aria-label="Display Egypt"><img src="/assets/images/logo-dea-light.webp" alt="Display Egypt Advertising" width="498" height="357" decoding="async"></a>
      <div class="de-social">
        {contact.social.map((s) => <a class="de-social__link" href={s.href} target="_blank" rel="noopener" aria-label={s.name}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={s.icon}/></svg></a>)}
      </div>
    </div>
    <nav class="de-footer__col" aria-label="Quick links">
      <h2>Navigate</h2>
      <ul>
        {[...nav, ['/contact-us/', 'Contact']].map(([href, label]) => <li><a class="de-flink" href={href}>{label}</a></li>)}
      </ul>
    </nav>
    <nav class="de-footer__col" aria-label="Services">
      <h2>Services</h2>
      <ul>{services.map((s) => <li><a class="de-flink" href={s.href}>{s.short ?? s.title}</a></li>)}</ul>
    </nav>
    <div class="de-footer__col de-footer__contact">
      <h2>Get in touch</h2>
      <ul>
        <li><small>WhatsApp</small><a class="de-flink" href={contact.phoneHref} target="_blank" rel="noopener">{contact.phone}</a></li>
        <li><small>Email</small><a class="de-flink" href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><small>Studio</small><span>{contact.address}</span></li>
      </ul>
    </div>
  </div>
  <div class="de-footer__bar"><div class="de-container de-footer__bar-inner"><p>&copy; {year} Display Egypt Advertising. All rights reserved.</p></div></div>
</footer>
<Lightbox />
<nav class="de-tabbar" aria-label="App navigation">
  {tabs.map(([href, label, icon]) => <a class={`de-tabbar__item${isActive(href) ? ' is-active' : ''}`} href={href} aria-current={isActive(href) ? 'page' : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon}></svg><span>{label}</span></a>)}
</nav>
<div class="de-install" hidden>
  <img src="/assets/icons/icon-192.png" alt="" width="44" height="44">
  <div><strong>Install the Display app</strong><span data-install-hint>Faster access, works offline.</span></div>
  <button type="button" class="de-install__go" data-install-go>Install</button>
  <button type="button" class="de-install__x" data-install-x aria-label="Dismiss">&times;</button>
</div>
<button class="de-totop" type="button" aria-label="Back to top"><span aria-hidden="true">↑</span></button>
<script is:inline src={`/assets/js/main.js?v=${v}`} defer></script>
<script>import "../scripts/motion.js";</script>
<script is:inline>
/* PWA: service worker + install prompt (Android/desktop Chrome use the native prompt, iPhone gets a how-to hint) */
(function(){
if("serviceWorker" in navigator)addEventListener("load",function(){navigator.serviceWorker.register("/sw.js").catch(function(){})});
var d=document.documentElement,box=document.querySelector(".de-install");if(!box||d.classList.contains("is-app"))return;
var ls;try{ls=localStorage}catch(e){ls=null}
if(ls&&ls.getItem("de-install-x"))return;
var ev=null,go=box.querySelector("[data-install-go]"),hint=box.querySelector("[data-install-hint]");
var ios=/iphone|ipad|ipod/i.test(navigator.userAgent)&&!window.MSStream;
function show(){if(window.innerWidth<=860)box.hidden=false}
addEventListener("beforeinstallprompt",function(e){e.preventDefault();ev=e;show()});
if(ios){go.hidden=true;hint.textContent="Tap Share, then Add to Home Screen.";setTimeout(show,4000)}
go.addEventListener("click",function(){if(!ev)return;ev.prompt();ev.userChoice.finally(function(){ev=null;box.hidden=true})});
box.querySelector("[data-install-x]").addEventListener("click",function(){box.hidden=true;if(ls)ls.setItem("de-install-x","1")});
addEventListener("appinstalled",function(){box.hidden=true});
})();
</script>
</body>
</html>
